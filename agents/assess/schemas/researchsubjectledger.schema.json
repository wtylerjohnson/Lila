{
  "$defs": {
    "AssessScope": {
      "description": "The operator-owned collection boundary for one Assess run.",
      "properties": {
        "agencies": {
          "items": {
            "$ref": "#/$defs/ScopeAgency"
          },
          "title": "Agencies",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/ScopeMode",
          "default": "all"
        }
      },
      "title": "AssessScope",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "notice",
        "agency_forecast",
        "award",
        "budget",
        "legislation",
        "regulation",
        "agency_announcement",
        "watchdog",
        "subaward",
        "vehicle",
        "news",
        "web_lead"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "description": "One immutable source-backed observation used by an Assess record.",
      "properties": {
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Date"
        },
        "primary_source": {
          "default": false,
          "title": "Primary Source",
          "type": "boolean"
        },
        "record_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Hash"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAcquisition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/EvidenceUse"
          },
          "title": "Supports",
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "evidence_id",
        "tier",
        "kind",
        "source_name",
        "source_url",
        "excerpt"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceTier": {
      "enum": [
        "notice",
        "program",
        "market",
        "discovery"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "EvidenceUse": {
      "enum": [
        "requirement",
        "timing",
        "funding",
        "buyer",
        "capability",
        "access",
        "incumbent",
        "counterevidence"
      ],
      "title": "EvidenceUse",
      "type": "string"
    },
    "ResearchSubject": {
      "additionalProperties": false,
      "description": "Observed source to investigate; never a buying prediction.",
      "properties": {
        "agency": {
          "title": "Agency",
          "type": "string"
        },
        "communication_permission": {
          "const": "none",
          "default": "none",
          "title": "Communication Permission",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "discovery_context_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Context Json"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "next_ask": {
          "minLength": 1,
          "title": "Next Ask",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Open Questions",
          "type": "array"
        },
        "reviewed_overlay_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Overlay Json"
        },
        "route_hypothesis": {
          "default": "Acquisition route remains to be established",
          "title": "Route Hypothesis",
          "type": "string"
        },
        "schema_version": {
          "default": "assess.research-subject.v1",
          "enum": [
            "assess.research-subject.v1",
            "assess.research-subject.v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "award",
            "forecast",
            "program"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_payload_json": {
          "title": "Source Payload Json",
          "type": "string"
        },
        "source_posture": {
          "enum": [
            "forecast_plan",
            "historical_award",
            "current_period_award",
            "award_timing_unknown",
            "published_program_signal"
          ],
          "title": "Source Posture",
          "type": "string"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_system": {
          "title": "Source System",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "const": "research_needed",
          "default": "research_needed",
          "title": "Status",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "source_kind",
        "source_posture",
        "source_system",
        "source_record_id",
        "source_url",
        "title",
        "agency",
        "source_payload_json",
        "source_sha256",
        "evidence",
        "open_questions",
        "next_ask"
      ],
      "title": "ResearchSubject",
      "type": "object"
    },
    "ScopeAgency": {
      "properties": {
        "abbr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbr"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ScopeAgency",
      "type": "object"
    },
    "ScopeMode": {
      "enum": [
        "all",
        "agency"
      ],
      "title": "ScopeMode",
      "type": "string"
    },
    "SourceAcquisition": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "sam_notice_depth",
            "horizon_fact_bank",
            "program_document_capture",
            "none"
          ],
          "title": "Basis",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "component": {
          "enum": [
            "notice_description",
            "notice_payload",
            "horizon_fact",
            "subaward_record",
            "research_record",
            "program_document"
          ],
          "title": "Component",
          "type": "string"
        },
        "input_types": {
          "default": [],
          "items": {
            "enum": [
              "text",
              "non_text",
              "missing"
            ],
            "type": "string"
          },
          "title": "Input Types",
          "type": "array"
        },
        "original_field": {
          "title": "Original Field",
          "type": "string"
        },
        "raw_values": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Raw Values",
          "type": "array"
        },
        "status": {
          "enum": [
            "known",
            "missing",
            "invalid",
            "date_only",
            "unknown_timezone",
            "conflict",
            "untrusted"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "const": "assess.source-acquisition.v1",
          "default": "assess.source-acquisition.v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "status",
        "basis",
        "component",
        "original_field",
        "binding_sha256"
      ],
      "title": "SourceAcquisition",
      "type": "object"
    }
  },
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "client_name": {
      "title": "Client Name",
      "type": "string"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResearchSubject"
      },
      "title": "Items",
      "type": "array"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AssessScope"
    }
  },
  "required": [
    "run_id",
    "client_name",
    "profile_version",
    "scope",
    "as_of"
  ],
  "title": "ResearchSubjectLedger",
  "type": "object"
}

{
  "$defs": {
    "AssessScope": {
      "description": "The operator-owned collection boundary for one Assess run.",
      "properties": {
        "agencies": {
          "items": {
            "$ref": "#/$defs/ScopeAgency"
          },
          "title": "Agencies",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/ScopeMode",
          "default": "all"
        }
      },
      "title": "AssessScope",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "not_registered"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "notice",
        "agency_forecast",
        "award",
        "budget",
        "legislation",
        "regulation",
        "agency_announcement",
        "watchdog",
        "subaward",
        "vehicle",
        "news",
        "web_lead"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "description": "One immutable source-backed observation used by an Assess record.",
      "properties": {
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Date"
        },
        "primary_source": {
          "default": false,
          "title": "Primary Source",
          "type": "boolean"
        },
        "record_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Hash"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAcquisition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/EvidenceUse"
          },
          "title": "Supports",
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "evidence_id",
        "tier",
        "kind",
        "source_name",
        "source_url",
        "excerpt"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceStrength": {
      "enum": [
        "early",
        "moderate",
        "strong"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "EvidenceTier": {
      "enum": [
        "notice",
        "program",
        "market",
        "discovery"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "EvidenceUse": {
      "enum": [
        "requirement",
        "timing",
        "funding",
        "buyer",
        "capability",
        "access",
        "incumbent",
        "counterevidence"
      ],
      "title": "EvidenceUse",
      "type": "string"
    },
    "GateStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "IntelligenceStatus": {
      "enum": [
        "proposed",
        "research_needed",
        "approved",
        "retired",
        "invalidated"
      ],
      "title": "IntelligenceStatus",
      "type": "string"
    },
    "LifecycleStage": {
      "enum": [
        "early_signal",
        "funded_intent",
        "acquisition_planning",
        "market_research",
        "presolicitation",
        "live_solicitation",
        "award",
        "recompete"
      ],
      "title": "LifecycleStage",
      "type": "string"
    },
    "LiveClassification": {
      "enum": [
        "bid_now",
        "market_research",
        "presolicitation",
        "special_notice",
        "amendment",
        "awarded_or_closed",
        "excluded",
        "unscreened"
      ],
      "title": "LiveClassification",
      "type": "string"
    },
    "LiveRecommendation": {
      "enum": [
        "pursue",
        "monitor",
        "no_bid",
        "research",
        "none"
      ],
      "title": "LiveRecommendation",
      "type": "string"
    },
    "LiveSolicitation": {
      "description": "One authoritative notice record in the live-solicitation census.",

{
  "$defs": {
    "AssessScope": {
      "description": "The operator-owned collection boundary for one Assess run.",
      "properties": {
        "agencies": {
          "items": {
            "$ref": "#/$defs/ScopeAgency"
          },
          "title": "Agencies",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/ScopeMode",
          "default": "all"
        }
      },
      "title": "AssessScope",
      "type": "object"
    },
    "AssessmentSubjectKind": {
      "description": "Parent subject grain. These are Assess ledger records, not leads.",
      "enum": [
        "research_subject",
        "live_solicitation",
        "developing_thesis",
        "partner_link",
        "motion_subject"
      ],
      "title": "AssessmentSubjectKind",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "notice",
        "agency_forecast",
        "award",
        "budget",
        "legislation",
        "regulation",
        "agency_announcement",
        "watchdog",
        "subaward",
        "vehicle",
        "news",
        "web_lead"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "description": "One immutable source-backed observation used by an Assess record.",
      "properties": {
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Date"
        },
        "primary_source": {
          "default": false,
          "title": "Primary Source",
          "type": "boolean"
        },
        "record_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Hash"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAcquisition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/EvidenceUse"
          },
          "title": "Supports",
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "evidence_id",
        "tier",
        "kind",
        "source_name",
        "source_url",
        "excerpt"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceTier": {
      "enum": [
        "notice",
        "program",
        "market",
        "discovery"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "EvidenceUse": {
      "enum": [
        "requirement",
        "timing",
        "funding",
        "buyer",
        "capability",
        "access",
        "incumbent",
        "counterevidence"
      ],
      "title": "EvidenceUse",
      "type": "string"
    },
    "LeadResearch": {
      "additionalProperties": false,
      "description": "Research priority is independent of qualification and outreach permission.",
      "properties": {
        "buyer_requirement": {
          "minLength": 1,
          "title": "Buyer Requirement",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fit_hypothesis": {
          "minLength": 1,
          "title": "Fit Hypothesis",
          "type": "string"
        },
        "next_ask": {
          "minLength": 1,
          "title": "Next Ask",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Open Questions",
          "type": "array"
        },
        "priority": {
          "default": false,
          "title": "Priority",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewed_by": {
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "route": {
          "minLength": 1,
          "title": "Route",
          "type": "string"
        },
        "status": {
          "enum": [
            "technical_qualification",
            "known_opportunity",
            "investigation",
            "deprioritized",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "why_now": {
          "minLength": 1,
          "title": "Why Now",
          "type": "string"
        }
      },
      "required": [
        "status",
        "rationale",
        "buyer_requirement",
        "fit_hypothesis",
        "route",
        "why_now",
        "next_ask",
        "open_questions",
        "reviewed_by",
        "reviewed_at",
        "evidence"
      ],
      "title": "LeadResearch",
      "type": "object"
    },
    "LeadTarget": {
      "additionalProperties": false,
      "properties": {
        "authority_boundary": {
          "minLength": 1,
          "title": "Authority Boundary",
          "type": "string"
        },
        "contact_status": {
          "minLength": 1,
          "title": "Contact Status",
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "next_ask": {
          "minLength": 1,
          "title": "Next Ask",
          "type": "string"
        },
        "organization": {
          "minLength": 1,
          "title": "Organization",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "reason_to_contact": {
          "minLength": 1,
          "title": "Reason To Contact",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "route": {
          "minLength": 1,
          "title": "Route",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "government_published",
            "company_published",
            "apollo"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "organization",
        "source_kind",
        "source_url",
        "contact_status",
        "route",
        "reason_to_contact",
        "next_ask",
        "authority_boundary",
        "evidence"
      ],
      "title": "LeadTarget",
      "type": "object"
    },
    "LifecycleStage": {
      "enum": [
        "early_signal",
        "funded_intent",
        "acquisition_planning",
        "market_research",
        "presolicitation",
        "live_solicitation",
        "award",
        "recompete"
      ],
      "title": "LifecycleStage",
      "type": "string"
    },
    "LiveClassification": {
      "enum": [
        "bid_now",
        "market_research",
        "presolicitation",
        "special_notice",
        "amendment",
        "awarded_or_closed",
        "excluded",
        "unscreened"
      ],
      "title": "LiveClassification",
      "type": "string"
    },
    "LiveRecommendation": {
      "enum": [
        "pursue",
        "monitor",
        "no_bid",
        "research",
        "none"
      ],
      "title": "LiveRecommendation",
      "type": "string"
    },
    "ResearchSubject": {
      "additionalProperties": false,
      "description": "Observed source to investigate; never a buying prediction.",
      "properties": {
        "agency": {
          "title": "Agency",
          "type": "string"
        },
        "communication_permission": {
          "const": "none",
          "default": "none",
          "title": "Communication Permission",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "discovery_context_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery Context Json"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "next_ask": {
          "minLength": 1,
          "title": "Next Ask",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Open Questions",
          "type": "array"
        },
        "reviewed_overlay_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Overlay Json"
        },
        "route_hypothesis": {
          "default": "Acquisition route remains to be established",
          "title": "Route Hypothesis",
          "type": "string"
        },
        "schema_version": {
          "default": "assess.research-subject.v1",
          "enum": [
            "assess.research-subject.v1",
            "assess.research-subject.v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "award",
            "forecast",
            "program"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_payload_json": {
          "title": "Source Payload Json",
          "type": "string"
        },
        "source_posture": {
          "enum": [
            "forecast_plan",
            "historical_award",
            "current_period_award",
            "award_timing_unknown",
            "published_program_signal"
          ],
          "title": "Source Posture",
          "type": "string"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_system": {
          "title": "Source System",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "const": "research_needed",
          "default": "research_needed",
          "title": "Status",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "source_kind",
        "source_posture",
        "source_system",
        "source_record_id",
        "source_url",
        "title",
        "agency",
        "source_payload_json",
        "source_sha256",
        "evidence",
        "open_questions",
        "next_ask"
      ],
      "title": "ResearchSubject",
      "type": "object"
    },
    "ScopeAgency": {
      "properties": {
        "abbr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbr"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ScopeAgency",
      "type": "object"
    },
    "ScopeMode": {
      "enum": [
        "all",
        "agency"
      ],
      "title": "ScopeMode",
      "type": "string"
    },
    "SourceAcquisition": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "sam_notice_depth",
            "horizon_fact_bank",
            "none"
          ],
          "title": "Basis",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "component": {
          "enum": [
            "notice_description",
            "notice_payload",
            "horizon_fact",
            "subaward_record",
            "research_record"
          ],
          "title": "Component",
          "type": "string"
        },
        "input_types": {
          "default": [],
          "items": {
            "enum": [
              "text",
              "non_text",
              "missing"
            ],
            "type": "string"
          },
          "title": "Input Types",
          "type": "array"
        },
        "original_field": {
          "title": "Original Field",
          "type": "string"
        },
        "raw_values": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Raw Values",
          "type": "array"
        },
        "status": {
          "enum": [
            "known",
            "missing",
            "invalid",
            "date_only",
            "unknown_timezone",
            "conflict",
            "untrusted"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "const": "assess.source-acquisition.v1",
          "default": "assess.source-acquisition.v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "status",
        "basis",
        "component",
        "original_field",
        "binding_sha256"
      ],
      "title": "SourceAcquisition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Parent pointer at one Assess subject.\n\nThis is not ``AssessRun`` and not ``AssessmentResult``. It copies the\nrun / subject identity a LeadRow must cite. Parents may have an empty\n``lead_ids`` list so opportunity identification does not depend on\nlead gen.",
  "properties": {
    "agency": {
      "minLength": 1,
      "title": "Agency",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "assess_run_id": {
      "minLength": 1,
      "title": "Assess Run Id",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "client_name": {
      "minLength": 1,
      "title": "Client Name",
      "type": "string"
    },
    "dossier_schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dossier Schema Version"
    },
    "identity_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity Status"
    },
    "lead_ids": {
      "items": {
        "type": "string"
      },
      "title": "Lead Ids",
      "type": "array"
    },
    "lifecycle": {
      "anyOf": [
        {
          "$ref": "#/$defs/LifecycleStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "live_classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveClassification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "live_recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notice_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notice Id"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "requirement_span": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirement Span"
    },
    "research": {
      "anyOf": [
        {
          "$ref": "#/$defs/LeadResearch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "research_subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchSubject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "leadgen.contracts.v1",
      "default": "leadgen.contracts.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AssessScope"
    },
    "solicitation_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solicitation Number"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_kind": {
      "$ref": "#/$defs/AssessmentSubjectKind"
    },
    "targets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LeadTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "assess_run_id",
    "client_name",
    "profile_version",
    "scope",
    "as_of",
    "subject_kind",
    "subject_id",
    "title",
    "agency"
  ],
  "title": "OpportunityAssessment",
  "type": "object"
}

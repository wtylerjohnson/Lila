{
  "$defs": {
    "AssessScope": {
      "description": "The operator-owned collection boundary for one Assess run.",
      "properties": {
        "agencies": {
          "items": {
            "$ref": "#/$defs/ScopeAgency"
          },
          "title": "Agencies",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/ScopeMode",
          "default": "all"
        }
      },
      "title": "AssessScope",
      "type": "object"
    },
    "AssessmentSubjectKind": {
      "description": "Parent subject grain. These are Assess ledger records, not leads.",
      "enum": [
        "live_solicitation",
        "developing_thesis",
        "partner_link",
        "motion_subject"
      ],
      "title": "AssessmentSubjectKind",
      "type": "string"
    },
    "LifecycleStage": {
      "enum": [
        "early_signal",
        "funded_intent",
        "acquisition_planning",
        "market_research",
        "presolicitation",
        "live_solicitation",
        "award",
        "recompete"
      ],
      "title": "LifecycleStage",
      "type": "string"
    },
    "LiveClassification": {
      "enum": [
        "bid_now",
        "market_research",
        "presolicitation",
        "special_notice",
        "amendment",
        "awarded_or_closed",
        "excluded",
        "unscreened"
      ],
      "title": "LiveClassification",
      "type": "string"
    },
    "LiveRecommendation": {
      "enum": [
        "pursue",
        "monitor",
        "no_bid",
        "research",
        "none"
      ],
      "title": "LiveRecommendation",
      "type": "string"
    },
    "ScopeAgency": {
      "properties": {
        "abbr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbr"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ScopeAgency",
      "type": "object"
    },
    "ScopeMode": {
      "enum": [
        "all",
        "agency"
      ],
      "title": "ScopeMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Parent pointer at one Assess subject.\n\nThis is not ``AssessRun`` and not ``AssessmentResult``. It copies the\nrun / subject identity a LeadRow must cite. Parents may have an empty\n``lead_ids`` list so opportunity identification does not depend on\nlead gen.",
  "properties": {
    "agency": {
      "minLength": 1,
      "title": "Agency",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "assess_run_id": {
      "minLength": 1,
      "title": "Assess Run Id",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "client_name": {
      "minLength": 1,
      "title": "Client Name",
      "type": "string"
    },
    "dossier_schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dossier Schema Version"
    },
    "identity_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity Status"
    },
    "lead_ids": {
      "items": {
        "type": "string"
      },
      "title": "Lead Ids",
      "type": "array"
    },
    "lifecycle": {
      "anyOf": [
        {
          "$ref": "#/$defs/LifecycleStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "live_classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveClassification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "live_recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notice_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notice Id"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "requirement_span": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirement Span"
    },
    "schema_version": {
      "const": "leadgen.contracts.v1",
      "default": "leadgen.contracts.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AssessScope"
    },
    "solicitation_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solicitation Number"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_kind": {
      "$ref": "#/$defs/AssessmentSubjectKind"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "assess_run_id",
    "client_name",
    "profile_version",
    "scope",
    "as_of",
    "subject_kind",
    "subject_id",
    "title",
    "agency"
  ],
  "title": "OpportunityAssessment",
  "type": "object"
}

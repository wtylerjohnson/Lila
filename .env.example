# Copy to .env and fill in. Never commit .env.
SAM_GOV_API_KEY=
USASPENDING_API_KEY=        # USAspending is public; key optional for higher rate limits
ANTHROPIC_API_KEY=
CRM_API_KEY=
CRM_BASE_URL=

# ---- External arbiter: OpenAI second judge for report drift control ----------
# Dormant until BOTH lines are set. Activation = fill key, flip toggle. No code.
OPENAI_API_KEY=
LILA_ENABLE_ARBITER_OPENAI=off
OPENAI_ARBITER_MODEL=gpt-4o          # override if you want a different judge model

# ---- Model routing & latency guards ------------------------------------------
# Research layers (company research, web-lead search) run a fast model; the
# strategy/fit/critic layers stay on Opus. LILA_LLM_TIMEOUT_S hard-fails any
# single Claude call that exceeds it, so a pipeline step can never hang silently.
# LILA_RESEARCH_MODEL=claude-sonnet-5
# LILA_RESEARCH_EFFORT=medium
# LILA_LLM_TIMEOUT_S=300

# ---- API toggles: LILA_ENABLE_<NAME>=on|off (unset = component default) ------
# LILA_ENABLE_SAM_GOV=on
# LILA_ENABLE_USASPENDING_GOV=on
# LILA_ENABLE_WEB=on
# LILA_ENABLE_APOLLO_HANDOFF=on

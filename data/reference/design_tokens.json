{
  "version": 1,
  "source": "Riverbed rework 2026-07-31 (client-approved). Supersedes Playfair/IBM Plex house style.",
  "color": {
    "page": "#e9eef3",
    "paper": "#ffffff",
    "ink": "#0b1728",
    "muted": "#5f6d7b",
    "rule": "#d4dde7",
    "wash": "#f3f6f9",
    "accent": "#fb461f",
    "accent-down": "#d93616",
    "link": "#157eaf",
    "link-wash": "#e7f4fa",
    "link-deep": "#0d5c81",
    "positive": "#13735b",
    "warn-ink": "#9d2a10",
    "warn-wash": "#fff2ee",
    "warn-border": "#f1a08d",
    "live-wash": "#effaf6",
    "live-border": "#77bfae",
    "board-border": "#dfe6ed"
  },
  "type": {
    "stack": "\"Avenir Next\", \"Segoe UI\", Inter, Arial, sans-serif",
    "mono": "ui-monospace, \"SFMono-Regular\", Consolas, monospace",
    "display": {"size": "clamp(37px,5vw,64px)", "line": 0.96, "tracking": "-0.048em", "weight": 900},
    "band-head": {"size": "clamp(24px,2.7vw,34px)", "line": 1.06, "tracking": "-0.03em", "weight": 900},
    "card-head": {"size": "16.5px", "line": 1.24, "tracking": "-0.018em", "weight": 900},
    "body": {"size": "12.5px", "line": 1.65, "weight": 600},
    "micro-label": {"size": "9.5px", "tracking": "0.08em", "transform": "uppercase", "weight": 850},
    "eyebrow": {"size": "11px", "tracking": "0.14em", "transform": "uppercase", "weight": 900, "color": "accent"},
    "mono-id": {"size": "10.5px", "weight": 700, "color": "link-deep"}
  },
  "layout": {
    "board-max": "1220px",
    "board-shadow": "0 18px 54px rgba(11,23,40,.14)",
    "band-pad": "34px 32px",
    "card-pad": "18px",
    "card-min": "272px",
    "utility-bar": {"bg": "ink", "border-bottom": "3px solid accent", "sticky": true}
  },
  "components": {
    "claim-ev-pill": {"border": "1px solid #b7cfdd", "bg": "link-wash", "ink": "link-deep", "arrow": "\u2197"},
    "deck-card-accent-top": {"act": "4px solid accent", "gate": "4px solid #94a5b6", "event": "4px solid positive"},
    "tone-edges": {"current": "accent", "rival": "link", "hist": "#94a5b6"},
    "expired-flag": {"bg": "accent", "ink": "#fff", "size": "8px"},
    "mark-sizes": {"seal": 38, "dmk": 26, "emk": 30, "pmk": 22, "cmk": 20},
    "monogram": {"bg": "#eef3f7", "ink": "muted", "border": "1px solid rule", "rule": "first letters of words, max 3, uppercase"}
  },
  "laws": {
    "no-em-dashes": true,
    "position-derived-band-numbers": true,
    "mark-slot-never-empty": true,
    "print": "board full-width, nav hidden, hrefs printed after anchors at 7.5px"
  }
}
